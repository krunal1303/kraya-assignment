generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// MODEL FOR USERS
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles UserRole[]

  createdItems Item[] @relation("CreatedItems")
  updatedItems Item[] @relation("UpdatedItems")

  createdVendors Vendor[] @relation("CreatedVendors")
  updatedVendors Vendor[] @relation("UpdatedVendors")

  createdIndents Indent[] @relation("CreatedIndents")
  updatedIndents Indent[] @relation("UpdatedIndents")

  createdMIs MI[] @relation("CreatedMIs")
  updatedMIs MI[] @relation("UpdatedMIs")

  createdRFQs RFQ[] @relation("CreatedRFQs")
  updatedRFQs RFQ[] @relation("UpdatedRFQs")

  @@map("users")
}

// MODEL FOR USERS
// userRoles relation is added - a many-to-many relationship between User and Role models
// userRoles Does not exist as a column, It's only there so that Prisma knows how tables are related
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("userRoles")
}

model Permission {
  id        String   @id @default(uuid())
  entity    String
  action    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([entity, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("rolePermissions")
}

model Item {
  id                  String   @id @default(uuid())
  itemId              String   @unique @map("item_id")
  companyId           String   @map("company_id")
  itemCode            String   @map("item_code")
  name                String
  description         String?
  unit                String
  price               Float
  createdByUserId     String   @map("created_by_user_id")
  lastUpdatedByUserId String   @map("last_updated_by_user_id")
  isLocked            Boolean  @default(false) @map("is_locked")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  createdByUser     User @relation("CreatedItems", fields: [createdByUserId], references: [id])
  lastUpdatedByUser User @relation("UpdatedItems", fields: [lastUpdatedByUserId], references: [id])

  miItems MIItem[]

  indentItems IndentItem[]

  rfqItems RFQItem[]

  @@map("items")
}

model Vendor {
  id                  String   @id @default(uuid())
  vendorId            String   @unique @map("vendor_id")
  companyId           String   @map("company_id")
  vendorCode          String   @map("vendor_code")
  name                String
  email               String
  phone               String
  address             String
  createdByUserId     String   @map("created_by_user_id")
  lastUpdatedByUserId String   @map("last_updated_by_user_id")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  createdByUser     User      @relation("CreatedVendors", fields: [createdByUserId], references: [id])
  lastUpdatedByUser User      @relation("UpdatedVendors", fields: [lastUpdatedByUserId], references: [id])
  rfqItems          RFQItem[]

  @@map("vendors")
}

model Indent {
  id String @id @default(uuid())

  indentId String @unique @map("indent_id")

  companyId  String @map("company_id")
  indentCode String @unique @map("indent_code")

  description String?

  createdByUserId     String @map("created_by_user_id")
  lastUpdatedByUserId String @map("last_updated_by_user_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUser     User @relation("CreatedIndents", fields: [createdByUserId], references: [id])
  lastUpdatedByUser User @relation("UpdatedIndents", fields: [lastUpdatedByUserId], references: [id])

  indentItems IndentItem[]

  @@map("indents")
}

model IndentItem {
  id String @id @default(uuid())

  indentId String @map("indent_id")
  itemId   String @map("item_id")

  quantity Int

  indent Indent @relation(fields: [indentId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@unique([indentId, itemId])
  @@map("indent_items")
}

model MI {
  id String @id @default(uuid())

  miId      String @unique @map("mi_id")
  companyId String @map("company_id")
  miCode    String @unique @map("mi_code")

  description String?

  createdByUserId     String @map("created_by_user_id")
  lastUpdatedByUserId String @map("last_updated_by_user_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUser     User @relation("CreatedMIs", fields: [createdByUserId], references: [id])
  lastUpdatedByUser User @relation("UpdatedMIs", fields: [lastUpdatedByUserId], references: [id])

  miItems MIItem[]

  @@map("mis")
}

model MIItem {
  id String @id @default(uuid())

  miId   String @map("mi_id")
  itemId String @map("item_id")

  quantity Int

  mi   MI   @relation(fields: [miId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([miId, itemId])
  @@map("mi_items")
}

model RFQ {
  id String @id @default(uuid())

  rfqId     String @unique @map("rfq_id")
  companyId String @map("company_id")
  rfqCode   String @unique @map("rfq_code")

  description String?

  createdByUserId     String @map("created_by_user_id")
  lastUpdatedByUserId String @map("last_updated_by_user_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdByUser     User @relation("CreatedRFQs", fields: [createdByUserId], references: [id])
  lastUpdatedByUser User @relation("UpdatedRFQs", fields: [lastUpdatedByUserId], references: [id])

  rfqItems RFQItem[]

  @@map("rfqs")
}

model RFQItem {
  id String @id @default(uuid())

  rfqId    String @map("rfq_id")
  itemId   String @map("item_id")
  vendorId String @map("vendor_id")

  quantity Int
  price    Float

  rfq    RFQ    @relation(fields: [rfqId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([rfqId, itemId, vendorId])
  @@map("rfq_items")
}
